<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <template class="PacketEditor" parent="GtkBox">
    <property name="orientation">vertical</property>

    <child>
      <object class="AdwToolbarView">

        <!-- Editor header -->
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwViewSwitcher">
                <property name="stack">editor_viewstack</property>
                <property name="policy">wide</property>
              </object>
            </property>
          </object>
        </child>

        <!-- Editor pages -->
        <property name="content">
          <object class="AdwViewStack" id="editor_viewstack">

            <!-- Edit page -->
            <child>
              <object class="AdwViewStackPage">
                <property name="name">edit</property>
                <property name="title" translatable="yes">Edit</property>
                <property name="icon-name">edit-symbolic</property>

                <property name="child">
                  <object class="GtkScrolledWindow" id="edit_page">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>

                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Packet fields editor</property>
                            <property name="wrap">True</property>
                          </object>
                        </child>

                      </object>
                    </property>
                  </object>
                </property>

              </object>
            </child>

            <!-- Preview page -->
            <child>
              <object class="AdwViewStackPage">
                <property name="name">preview</property>
                <property name="title" translatable="yes">Preview</property>
                <property name="icon-name">data-symbolic</property>

                <property name="child">
                  <object class="GtkScrolledWindow">
                    <property name="vexpand">True</property>

                    <child>
                      <object class="GtkTextView" id="preview_textview">
                        <!-- Style with rounded corners -->
                        <style>
                          <class name="card"/>
                        </style>
                        <!-- Margin for text view -->
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-bottom">6</property>
                        <!-- Margin for text in the text view -->
                        <property name="left-margin">12</property>
                        <property name="right-margin">12</property>
                        <property name="top-margin">12</property>
                        <property name="bottom-margin">12</property>
                        <!-- Text properties -->
                        <property name="editable">False</property>
                        <property name="cursor-visible">False</property>
                        <property name="monospace">True</property>
                        <!-- Text buffer -->
                        <property name="buffer">
                          <object class="GtkTextBuffer">
                            <property name="text" translatable="yes">Packet preview will appear here.</property>
                          </object>
                        </property>
                      </object>
                    </child>

                  </object>
                </property>

              </object>
            </child>

          </object>
        </property>
      </object>
    </child>

  </template>
</interface>

