<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <template class="EditorPage" parent="GtkBox">
    <property name="orientation">vertical</property>

    <!-- AdwClamp used to constrain the width of child widgets -->
    <child>
      <object class="AdwClamp">
        <property name="maximum-size">650</property>
        <property name="tightening-threshold">650</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-bottom">12</property>

        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">24</property>

            <!-- Data Link Layer -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Data Link Layer</property>

                <child>
                  <object class="AdwComboRow" id="data_link_protocol_row">
                    <property name="title" translatable="yes">Protocol</property>
                  </object>
                </child>

              </object>
            </child>

            <child>
              <object class="GtkStack" id="data_link_protocols_stack"/>
            </child>

            <!-- Network Layer -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Network Layer</property>

                <child>
                  <object class="AdwComboRow" id="network_protocol_row">
                    <property name="title" translatable="yes">Protocol</property>
                  </object>
                </child>

              </object>
            </child>

            <child>
              <object class="GtkStack" id="network_protocols_stack"/>
            </child>

            <!-- Transport Layer -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Transport Layer</property>

                <child>
                  <object class="AdwComboRow" id="transport_protocol_row">
                    <property name="title" translatable="yes">Protocol</property>
                  </object>
                </child>

              </object>
            </child>

            <child>
              <object class="GtkStack" id="transport_protocols_stack"/>
            </child>

          </object>
        </child>

      </object>
    </child>

  </template>
</interface>


