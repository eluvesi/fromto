<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <template class="IPv4SettingsGroup" parent="AdwPreferencesGroup">

    <child>
      <object class="AdwEntryRow" id="src_entryrow">
        <property name="title" translatable="yes">Source IP Address</property>
        <property name="max-length">15</property>

        <child type="suffix">
          <object class="GtkButton" id="src_auto_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Autofill Source IP</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwEntryRow" id="dst_entryrow">
        <property name="title" translatable="yes">Destination IP Address</property>
        <property name="max-length">15</property>
      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="version_spinrow">
        <property name="title" translatable="yes">Version</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">15</property>
            <property name="step-increment">1</property>
            <property name="page-increment">1</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="version_reset_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Reset Version</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="ihl_spinrow">
        <property name="title" translatable="yes">Header Length</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">15</property>
            <property name="step-increment">1</property>
            <property name="page-increment">1</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="ihl_auto_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Calculate Header Length</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="tos_spinrow">
        <property name="title" translatable="yes">Type of Service</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">255</property>
            <property name="step-increment">1</property>
            <property name="page-increment">16</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="tos_reset_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Reset Type of Service</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="len_spinrow">
        <property name="title" translatable="yes">Total Length</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">65535</property>
            <property name="step-increment">1</property>
            <property name="page-increment">1024</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="len_auto_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Calculate Total Length</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="id_spinrow">
        <property name="title" translatable="yes">Identification</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">65535</property>
            <property name="step-increment">1</property>
            <property name="page-increment">1024</property>
            <property name="value">1</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="id_reset_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Reset Identification</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwActionRow" id="flags_actionrow">
        <property name="title" translatable="yes">Flags</property>

        <child>
          <object class="GtkBox">
            <property name="valign">center</property>
            <style>
              <class name="linked"/>
            </style>

            <child>
              <object class="GtkToggleButton" id="flags_r_button">
                <property name="label" translatable="no">[R]</property>
                <property name="tooltip-text" translatable="yes">Reserved</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="flags_d_button">
                <property name="label" translatable="no">[D]</property>
                <property name="tooltip-text" translatable="yes">Don't Fragment</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="flags_m_button">
                <property name="label" translatable="no">[M]</property>
                <property name="tooltip-text" translatable="yes">More Fragments</property>
              </object>
            </child>

          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="frag_spinrow">
        <property name="title" translatable="yes">Fragment Offset</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">8191</property>
            <property name="step-increment">1</property>
            <property name="page-increment">512</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="frag_reset_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Reset Fragment Offset</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="ttl_spinrow">
        <property name="title" translatable="yes">Time to Live</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">255</property>
            <property name="step-increment">1</property>
            <property name="page-increment">16</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="ttl_reset_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Reset Time to Live</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="proto_spinrow">
        <property name="title" translatable="yes">Protocol</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">255</property>
            <property name="step-increment">1</property>
            <property name="page-increment">16</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="proto_auto_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Autofill Protocol</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="chksum_spinrow">
        <property name="title" translatable="yes">Header Checksum</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">65535</property>
            <property name="step-increment">1</property>
            <property name="page-increment">1024</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="chksum_auto_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Calculate Header Checksum</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

  </template>

</interface>
  
