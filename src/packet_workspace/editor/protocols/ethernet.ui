<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <template class="EthernetSettingsGroup" parent="AdwPreferencesGroup">

    <child>
      <object class="AdwEntryRow" id="src_entryrow">
        <property name="title" translatable="yes">Source MAC Address</property>
        <property name="max-length">17</property>
        <property name="text">00:00:00:00:00:00</property>

        <child type="suffix">
          <object class="GtkButton" id="src_auto_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Restore Default</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwEntryRow" id="dst_entryrow">
        <property name="title" translatable="yes">Destination MAC Address</property>
        <property name="max-length">17</property>
        <property name="text">00:00:00:00:00:00</property>

        <child type="suffix">
          <object class="GtkButton" id="dst_auto_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Restore Default</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="type_spinrow">
        <property name="title" translatable="yes">EtherType</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">65535</property>
            <property name="step-increment">1</property>
            <property name="page-increment">1024</property>
            <property name="value">2048</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="type_restore_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Restore Default</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

  </template>

</interface>
  
