<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <template class="TCPSettingsGroup" parent="AdwPreferencesGroup">

    <child>
      <object class="AdwSpinRow" id="sport_spinrow">
        <property name="title" translatable="yes">Source Port</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">65535</property>
            <property name="step-increment">1</property>
            <property name="page-increment">1024</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="sport_reset_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Reset Source Port</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="dport_spinrow">
        <property name="title" translatable="yes">Destination Port</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">65535</property>
            <property name="step-increment">1</property>
            <property name="page-increment">1024</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="dport_reset_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Reset Destination Port</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="seq_spinrow">
        <property name="title" translatable="yes">Sequence Number</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">4294967295</property>
            <property name="step-increment">1</property>
            <property name="page-increment">65536</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="seq_reset_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Reset Sequence Number</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="ack_spinrow">
        <property name="title" translatable="yes">Acknowledgment Number</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">4294967295</property>
            <property name="step-increment">1</property>
            <property name="page-increment">65536</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="ack_reset_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Reset Acknowledgment Number</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="dataofs_spinrow">
        <property name="title" translatable="yes">Data Offset</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">15</property>
            <property name="step-increment">1</property>
            <property name="page-increment">1</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="dataofs_auto_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Calculate Data Offset</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwActionRow" id="reserved_actionrow">
        <property name="title" translatable="yes">Reserved Bits</property>

        <child>
          <object class="GtkBox">
            <property name="valign">center</property>
            <style>
              <class name="linked"/>
            </style>

            <child>
              <object class="GtkToggleButton" id="reserved_2_button">
                <property name="label" translatable="no">[R2]</property>
                <property name="tooltip-text" translatable="yes">Reserved</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="reserved_1_button">
                <property name="label" translatable="no">[R1]</property>
                <property name="tooltip-text" translatable="yes">Reserved</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="reserved_0_button">
                <property name="label" translatable="no">[R0]</property>
                <property name="tooltip-text" translatable="yes">Reserved</property>
              </object>
            </child>

          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwActionRow" id="flags_actionrow">
        <property name="title" translatable="yes">Flags</property>

        <child>
          <object class="GtkBox">
            <property name="valign">center</property>
            <style>
              <class name="linked"/>
            </style>

            <child>
              <object class="GtkToggleButton" id="flag_ns_button">
                <property name="label" translatable="no">NS</property>
                <property name="tooltip-text" translatable="yes">Nonce Sum</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="flag_cwr_button">
                <property name="label" translatable="no">CWR</property>
                <property name="tooltip-text" translatable="yes">Congestion Window Reduced</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="flag_ece_button">
                <property name="label" translatable="no">ECE</property>
                <property name="tooltip-text" translatable="yes">ECN-Echo</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="flag_urg_button">
                <property name="label" translatable="no">URG</property>
                <property name="tooltip-text" translatable="yes">Urgent</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="flag_ack_button">
                <property name="label" translatable="no">ACK</property>
                <property name="tooltip-text" translatable="yes">Acknowledgment</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="flag_psh_button">
                <property name="label" translatable="no">PSH</property>
                <property name="tooltip-text" translatable="yes">Push</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="flag_rst_button">
                <property name="label" translatable="no">RST</property>
                <property name="tooltip-text" translatable="yes">Reset</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="flag_syn_button">
                <property name="label" translatable="no">SYN</property>
                <property name="tooltip-text" translatable="yes">Synchronize</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="flag_fin_button">
                <property name="label" translatable="no">FIN</property>
                <property name="tooltip-text" translatable="yes">Finish</property>
              </object>
            </child>

          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="window_spinrow">
        <property name="title" translatable="yes">Window Size</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">65535</property>
            <property name="step-increment">1</property>
            <property name="page-increment">1024</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="window_reset_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Reset Window Size</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="chksum_spinrow">
        <property name="title" translatable="yes">Header Checksum</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">65535</property>
            <property name="step-increment">1</property>
            <property name="page-increment">1024</property>
            <property name="value">0</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="chksum_auto_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Calculate Header Checksum</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="AdwSpinRow" id="urgptr_spinrow">
        <property name="title" translatable="yes">Urgent Pointer</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">0</property>
            <property name="upper">65535</property>
            <property name="step-increment">1</property>
            <property name="page-increment">1024</property>
            <property name="value">0</property>
          </object>
        </property>

        <child type="suffix">
          <object class="GtkButton" id="urgptr_reset_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Reset Urgent Pointer</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>

      </object>
    </child>

  </template>

</interface>
  
